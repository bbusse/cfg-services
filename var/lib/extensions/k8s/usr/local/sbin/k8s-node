#!/bin/sh
# Brings this node into its cluster once: the bootstrap master runs kubeadm
# init, another master joins as control plane, a client joins as a node. A
# failed attempt is reset before the next one, and a master's shared PKI is
# put back from /etc/provision/k8s-pki each time. A master announces its API
# server over DNS-SD once it runs
set -eu
# shellcheck source=/dev/null
. /etc/provision/k8s.conf

announce() {
    mkdir -p /etc/systemd/dnssd /etc/systemd/resolved.conf.d /etc/systemd/network/20-dhcp.network.d
    cat >/etc/systemd/dnssd/k8s-api.dnssd <<DNSSD
[Service]
Name=%H
Type=_k8s-api._tcp
Port=6443
TxtText=cluster=${K8S_CLUSTER}
DNSSD
    printf '[Resolve]\nMulticastDNS=yes\n' >/etc/systemd/resolved.conf.d/k8s-mdns.conf
    printf '[Network]\nMulticastDNS=yes\n' >/etc/systemd/network/20-dhcp.network.d/k8s-mdns.conf
    networkctl reload
    systemctl restart systemd-resolved.service
}

if [ -s /etc/kubernetes/kubelet.conf ] && [ ! -e /var/lib/provision/k8s-attempt ]; then
    exit 0
fi
if [ -e /var/lib/provision/k8s-attempt ]; then
    kubeadm reset -f >/dev/null 2>&1 || true
fi
mkdir -p /var/lib/provision
touch /var/lib/provision/k8s-attempt

# Without an IPv4 default route the node uses the stable global IPv6 address
# of its IPv6 default route, a ULA before others, otherwise kubeadm picks the
# address as before
node_ip=""
kubelet_args="[]"
if [ -z "$(ip -4 route show default)" ]; then
    dev="$(ip -6 route show default | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
    if [ -n "${dev}" ]; then
        node_ip="$(ip -6 addr show dev "${dev}" scope global | awk '
            $1 == "inet6" && !/temporary|deprecated|tentative/ {
                sub(/\/.*/, "", $2)
                if ($2 ~ /^f[cd]/) { print $2; found = 1; exit }
                if (first == "") first = $2
            }
            END { if (!found && first != "") print first }')"
    fi
    if [ -z "${node_ip}" ]; then
        echo "k8s-node: no default route with a global address" >&2
        exit 1
    fi
    kubelet_args="[{name: node-ip, value: \"${node_ip}\"}]"
fi

mkdir -p /etc/kubernetes
if [ "${K8S_ROLE}" = master ]; then
    rm -rf /etc/kubernetes/pki
    cp -a /etc/provision/k8s-pki /etc/kubernetes/pki
fi

join() {
    cat >/etc/kubernetes/kubeadm-join.yaml <<YAML
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "${K8S_ENDPOINT}"
    token: "${K8S_TOKEN}"
    caCertHashes: ["${K8S_CA_CERT_HASH}"]
nodeRegistration:
  name: "$(hostname)"
  ignorePreflightErrors: [Swap]
  kubeletExtraArgs: ${kubelet_args}
YAML
    if [ "${K8S_ROLE}" = master ]; then
        printf 'controlPlane:\n  localAPIEndpoint:\n    advertiseAddress: "%s"\n' "${node_ip}" >>/etc/kubernetes/kubeadm-join.yaml
    fi
    kubeadm join --config /etc/kubernetes/kubeadm-join.yaml
}

if [ "${K8S_ROLE}" = master ] && [ "${K8S_BOOTSTRAP}" = yes ]; then
    cat >/etc/kubernetes/kubeadm-init.yaml <<YAML
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
  - token: "${K8S_TOKEN}"
    ttl: "0s"
    usages: [signing, authentication]
    groups: [system:bootstrappers:kubeadm:default-node-token]
localAPIEndpoint:
  advertiseAddress: "${node_ip}"
nodeRegistration:
  name: "$(hostname)"
  ignorePreflightErrors: [Swap]
  kubeletExtraArgs: ${kubelet_args}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: "${K8S_CLUSTER}"
controlPlaneEndpoint: "${K8S_ENDPOINT}"
networking:
  podSubnet: "${K8S_POD_CIDR}"
  serviceSubnet: "${K8S_SERVICE_CIDR}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
failSwapOn: false
memorySwap:
  swapBehavior: NoSwap
YAML
    kubeadm init --config /etc/kubernetes/kubeadm-init.yaml
    mkdir -p /root/.kube
    install -m 0600 /etc/kubernetes/admin.conf /root/.kube/config
    announce
elif [ "${K8S_ROLE}" = master ]; then
    join
    mkdir -p /root/.kube
    install -m 0600 /etc/kubernetes/admin.conf /root/.kube/config
    announce
else
    join
fi
rm -f /var/lib/provision/k8s-attempt
echo "k8s-node: $(hostname) is in cluster ${K8S_CLUSTER} as ${K8S_ROLE}"
