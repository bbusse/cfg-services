#!/bin/sh
# The Secrets provisioning brought to a master, as bsd8 applies them: an
# Opaque Secret for each NAMESPACE/NAME in /etc/provision/k8s-secrets,
# labelled as provisioning's, once the component that needs it made its
# namespace. One that left the directory is deleted, without the directory
# nothing is
set -eu
dir=/etc/provision/k8s-secrets
label=app.kubernetes.io/managed-by=provision
[ -d "${dir}" ] && [ -s /etc/kubernetes/admin.conf ] || exit 0
export KUBECONFIG=/etc/kubernetes/admin.conf

keep=""
for secret in "${dir}"/*/*/; do
    [ -d "${secret}" ] || continue
    secret="${secret%/}"
    name="${secret##*/}"
    ns="${secret%/*}"
    ns="${ns##*/}"
    keep="${keep}${ns}/${name}
"
    if ! kubectl get namespace "${ns}" >/dev/null 2>&1; then
        echo "k8s-secrets: ${ns}/${name} waits for its namespace"
        continue
    fi
    kubectl create secret generic "${name}" -n "${ns}" --from-file="${secret}" --dry-run=client -o yaml |
        kubectl label --local -f - "${label}" -o yaml |
        kubectl apply --server-side --force-conflicts --field-manager=k8s-secrets -f -
done
kubectl get secrets -A -l "${label}" \
    -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}' |
    while read -r ref; do
        if ! printf '%s' "${keep}" | awk -v ref="${ref}" '$0 == ref { found = 1 } END { exit !found }'; then
            echo "k8s-secrets: deleting ${ref}, it left ${dir}"
            kubectl delete secret -n "${ref%/*}" "${ref#*/}"
        fi
    done
