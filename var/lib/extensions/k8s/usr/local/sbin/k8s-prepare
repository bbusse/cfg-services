#!/bin/sh
# Kernel and containerd settings kubeadm expects
set -eu
# shellcheck source=/dev/null
. /etc/provision/k8s.conf

# A kernel without modules has them built in and modprobe fails on it
load() {
    if modprobe "${1}" 2>/dev/null; then
        printf '%s\n' "${1}" >>/etc/modules-load.d/k8s.conf
    elif [ ! -e "${2}" ]; then
        modprobe "${1}"
    fi
}
mkdir -p /etc/modules-load.d /etc/sysctl.d
: >/etc/modules-load.d/k8s.conf
load overlay /sys/module/overlay
load br_netfilter /proc/sys/net/bridge
cat >/etc/sysctl.d/90-k8s.conf <<SYSCTL
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
SYSCTL
# With forwarding on the kernel ignores RAs unless accept_ra is 2
egress="$(ip -6 route show default | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
if [ -n "${egress}" ]; then
    printf 'net.ipv6.conf.%s.accept_ra = 2\n' "${egress}" >>/etc/sysctl.d/90-k8s.conf
fi
sysctl -q -p /etc/sysctl.d/90-k8s.conf

if [ -n "${K8S_PROXY:-}" ]; then
    no_proxy="localhost,::1,${K8S_POD_CIDR},${K8S_SERVICE_CIDR},${K8S_ENDPOINT_HOST},.svc,.cluster.local"
    if [ -n "${K8S_NO_PROXY:-}" ]; then
        no_proxy="${K8S_NO_PROXY},${no_proxy}"
    fi
    dropin=/etc/systemd/system/containerd.service.d/proxy.conf
    mkdir -p "${dropin%/*}"
    cat >"${dropin}.new" <<UNIT
[Service]
Environment=HTTP_PROXY=${K8S_PROXY}
Environment=HTTPS_PROXY=${K8S_PROXY}
Environment=NO_PROXY=${no_proxy}
UNIT
    if cmp -s "${dropin}.new" "${dropin}"; then
        rm -f "${dropin}.new"
    else
        mv "${dropin}.new" "${dropin}"
        systemctl daemon-reload
        systemctl try-restart containerd.service
    fi
fi

mkdir -p /etc/containerd
# zot, a cluster's pull-through cache, is a NodePort and so at every node's
# localhost:30500, with each registry below its own path. containerd looks a
# tag up at the registry, as zot never asks again for one it has, and then
# gets the image from zot. What zot does not have or does not answer for
# comes from the registry, so a cluster without zot loses nothing. The
# registries are the ones zot's config has. containerd reads the files for
# every pull, a change needs no restart
mirror=http://localhost:30500
certs=/etc/containerd/certs.d
for registry in docker.io ghcr.io quay.io registry.k8s.io data.forgejo.org; do
    server="https://${registry}"
    if [ "${registry}" = docker.io ]; then
        server=https://registry-1.docker.io
    fi
    mkdir -p "${certs}/${registry}"
    cat >"${certs}/${registry}/hosts.toml.new" <<HOSTS
server = "${server}"

[host."${mirror}/v2/${registry}"]
  capabilities = ["pull"]
  override_path = true
  dial_timeout = "2s"
HOSTS
    mv "${certs}/${registry}/hosts.toml.new" "${certs}/${registry}/hosts.toml"
done

if [ ! -s /etc/containerd/config.toml ]; then
    containerd config default >/etc/containerd/config.toml.new
    mv /etc/containerd/config.toml.new /etc/containerd/config.toml
fi
# config_path is empty by default, and the hosts.toml files unread. Only the
# CRI plugin's registry section gets it, the one whose name ends in .registry
awk -v certs="${certs}" '
    /^[[:space:]]*\[/ { registry = /\.registry\][[:space:]]*$/ }
    registry && /^[[:space:]]*config_path = / { sub(/config_path = .*/, "config_path = \"" certs "\"") }
    { sub(/SystemdCgroup = false/, "SystemdCgroup = true") }
    1' /etc/containerd/config.toml >/etc/containerd/config.toml.new
if cmp -s /etc/containerd/config.toml.new /etc/containerd/config.toml; then
    rm -f /etc/containerd/config.toml.new
else
    mv /etc/containerd/config.toml.new /etc/containerd/config.toml
    systemctl restart containerd.service
fi
systemctl enable --now containerd.service
