[Unit]
Description=mpv TV on tty1 as %i
After=systemd-user-sessions.service
Conflicts=getty@tty1.service autovt@tty1.service

[Service]
User=%i
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=URL_TV=https://raw.githubusercontent.com/jnk22/kodinerds-iptv/master/iptv/clean/clean_tv.m3u
EnvironmentFile=-/home/%i/.config/environment.d/50-provision.conf
ExecStart=/usr/local/bin/mpv-tv-vt
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=role-tv.target
