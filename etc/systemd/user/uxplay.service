[Unit]
Description=AirPlay screen mirroring receiver
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
ExecStart=/usr/bin/uxplay -fs -n %H -nh -vs waylandsink -as "pipewiresink stream-properties=props,node.rate=(string)1/44100,node.latency=(string)4096/44100"
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=sway-session.target
