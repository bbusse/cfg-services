#!/bin/sh
# Cilium as the cluster's network, installed once from the bootstrap master
# with the pod CIDR provisioning gave, Cilium's own default would cover 10/8
# Pinned: Kernels from 7.2 reject a probe of Cilium before 1.20.2, and
# cilium-cli v0.20.1 defaults to 1.20.1
set -eu
# shellcheck source=/dev/null
. /etc/provision/k8s.conf
[ "${K8S_ROLE}" = master ] && [ "${K8S_BOOTSTRAP}" = yes ] || exit 0
export KUBECONFIG=/etc/kubernetes/admin.conf
if cilium status >/dev/null 2>&1; then
    exit 0
fi
cilium install --version 1.20.4 --set ipam.mode=cluster-pool \
    --set "ipam.operator.clusterPoolIPv4PodCIDRList={${K8S_POD_CIDR}}"
cilium status --wait --wait-duration 10m
